# Copy to .env.local for local development. Never commit real values.

# Postgres connection used by the running app (Neon: pooled string; local: Docker).
DATABASE_URL=
# Postgres connection used by migrations and scripts (Neon: direct string; local: Docker).
MIGRATION_DATABASE_URL=

# Better Auth: random 32+ byte secret, different per environment (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Public base URL of the app, e.g. http://localhost:3000.
BETTER_AUTH_URL=
# Google OAuth client (optional locally).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The only email allowed to have an account.
OWNER_EMAIL=
# local | preview | production
APP_ENV=local
# "true" enables email+password sign-in (never honoured when APP_ENV=production).
ENABLE_PASSWORD_LOGIN=

# E2E test accounts (local and preview only).
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_INTRUDER_EMAIL=
E2E_INTRUDER_PASSWORD=
# Target for Playwright; unset = start the app locally.
E2E_BASE_URL=
# Vercel "Protection Bypass for Automation" secret, for E2E against previews.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Web Push for the evening reminder (npx web-push generate-vapid-keys).
# The public key also goes to the browser; the subject is a mailto: or https: URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
